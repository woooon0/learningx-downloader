{
  "manifest_version": 3,
  "name": "Hanyang LearningX Downloader",
  "version": "0.5.1",
  "author": "mechaminu",
  "description": "한양대 강의 플레이어에 로드된 영상을 저장합니다.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "한양대 강의 저장"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://learning.hanyang.ac.kr/*",
    "https://hycms.hanyang.ac.kr/*",
    "http://127.0.0.1:52022/*"
  ]
}